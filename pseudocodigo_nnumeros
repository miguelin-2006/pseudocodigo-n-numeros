'''
ALGORITMO: SUMAR_N_NUMEROS
ENTRADAS: n
SALIDA: suma

    suma = 0
    
    MIENTRAS n > 0:
        suma = suma + n
        n = n - 1

    DEVOLVER suma

LLAMADAS:
    SUMAR_N_NUMEROS(10) -> 55
    SUMAR_N_NUMEROS(5)  -> 15
'''

# 1. Definimos la función según las indicaciones del profesor
def function(n):
    suma = 0
    
    while n > 0:
        suma = suma + n
        n = n - 1  # Restamos 1 en cada vuelta
        
    return suma


# 2. Invocamos la función con datos de prueba
print("Resultado para n = 10:")
print(function(10))

print("Resultado para n = 5:")
print(function(5))